---
// Calculadora de clima: las mismas fórmulas que Weather en TorkeKit (Magnus, densidad del aire,
// altitud de densidad y corrección SAE J1349), aplicadas a la corrida demo.
---

<div class="tk-lab not-content" data-weather>
	<div class="tk-lab-head">
		<b>Calculadora de clima</b>
		<small>La corrida demo (12,826 s) con el aire que elijas</small>
		<button type="button" data-preset="sea">Nivel del mar</button>
		<button type="button" data-preset="cr" style="margin-inline-start:0">Pista en Costa Rica</button>
	</div>
	<div class="tk-sliders">
		<div class="tk-slider">
			<label for="tk-w-t">Temperatura</label>
			<input id="tk-w-t" type="range" min="0" max="45" step="1" value="31" data-k="t" />
			<output data-o="t"></output>
		</div>
		<div class="tk-slider">
			<label for="tk-w-h">Humedad relativa</label>
			<input id="tk-w-h" type="range" min="0" max="100" step="1" value="70" data-k="h" />
			<output data-o="h"></output>
		</div>
		<div class="tk-slider">
			<label for="tk-w-p">Presión de la estación</label>
			<input id="tk-w-p" type="range" min="780" max="1040" step="1" value="910" data-k="p" />
			<output data-o="p"></output>
		</div>
	</div>
	<div class="tk-readouts">
		<div class="tk-readout" data-r="da"><small>Altitud de densidad</small><strong></strong></div>
		<div class="tk-readout" data-r="cf"><small>Factor SAE J1349</small><strong></strong></div>
		<div class="tk-readout is-good" data-r="et"><small>1/4 corregido</small><strong></strong></div>
		<div class="tk-readout" data-r="hp"><small>Potencia que se pierde</small><strong></strong></div>
	</div>
</div>

<script>
	const DEMO_QUARTER = 12.825751459085067;

	function weather(t: number, h: number, p: number) {
		const vapor = 6.1094 * Math.exp((17.625 * t) / (t + 243.04)) * Math.min(Math.max(h, 0), 100) / 100;
		const dry = p - vapor;
		const k = t + 273.15;
		const density = (dry * 100) / (287.058 * k) + (vapor * 100) / (461.495 * k);
		const densityAltitude = 44330.8 * (1 - Math.pow(density / 1.225, 0.234969));
		const factor = 1.18 * (990 / dry) * Math.sqrt(k / 298.15) - 0.18;
		return { densityAltitude, factor, corrected: DEMO_QUARTER * Math.pow(factor, -1 / 3) };
	}

	const presets: Record<string, [number, number, number]> = { sea: [25, 0, 990], cr: [31, 70, 910] };
	const fmt = (n: number, d = 0) => n.toLocaleString('es-CR', { minimumFractionDigits: d, maximumFractionDigits: d });

	for (const root of document.querySelectorAll<HTMLElement>('[data-weather]')) {
		const inputs = Object.fromEntries(
			[...root.querySelectorAll<HTMLInputElement>('input[data-k]')].map((i) => [i.dataset.k!, i]),
		);
		const out = (k: string) => root.querySelector<HTMLElement>(`[data-o="${k}"]`)!;
		const card = (k: string) => root.querySelector<HTMLElement>(`[data-r="${k}"]`)!;

		const update = () => {
			const t = +inputs.t.value, h = +inputs.h.value, p = +inputs.p.value;
			for (const i of Object.values(inputs)) {
				i.style.setProperty('--fill', `${((+i.value - +i.min) / (+i.max - +i.min)) * 100}%`);
			}
			out('t').textContent = `${t} °C`;
			out('h').textContent = `${h} %`;
			out('p').textContent = `${p} hPa`;
			const w = weather(t, h, p);
			card('da').querySelector('strong')!.innerHTML = `${fmt(w.densityAltitude)}<em>m</em>`;
			card('cf').querySelector('strong')!.textContent = fmt(w.factor, 3);
			card('et').querySelector('strong')!.innerHTML = `${fmt(w.corrected, 3)}<em>s</em>`;
			const lost = (1 - 1 / w.factor) * 100;
			const hp = card('hp');
			hp.querySelector('strong')!.innerHTML = `${fmt(Math.max(lost, 0), 1)}<em>%</em>`;
			hp.classList.toggle('is-warn', lost > 5 && lost <= 12);
			hp.classList.toggle('is-bad', lost > 12);
			hp.classList.toggle('is-good', lost <= 5);
		};

		Object.values(inputs).forEach((i) => i.addEventListener('input', update));
		root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) =>
			b.addEventListener('click', () => {
				const [t, h, p] = presets[b.dataset.preset!];
				inputs.t.value = String(t);
				inputs.h.value = String(h);
				inputs.p.value = String(p);
				update();
			}),
		);
		update();
	}
</script>
